#!/usr/bin/env bash
# config/port.env
#
# Central defaults for the HyperOS annibale -> marble port pipeline.
# Every value here is overridable via workflow_dispatch inputs (see
# .github/workflows/port-hyperos.yml). This file is sourced by every
# script, never executed directly.
#
# Do NOT put secrets here. Secrets (PATs, signing keys) come from
# GitHub Actions Secrets and are exported by the workflow, never
# written to this file.

# --- ROM identity -----------------------------------------------------
SOURCE_DEVICE="${SOURCE_DEVICE:-annibale}"
SOURCE_ANDROID="${SOURCE_ANDROID:-17}"
SOURCE_BUILD="${SOURCE_BUILD:-OS4.0.0.31.XPKCNXM}"
SOURCE_ROM_URL="${SOURCE_ROM_URL:-https://bkt-sgp-miui-ota-update-alisgp.oss-ap-southeast-1.aliyuncs.com/OS4.0.0.31.XPKCNXM/annibale-ota_full-OS4.0.0.31.XPKCNXM-user-17.0-030a02c3d6.zip}"

TARGET_DEVICE="${TARGET_DEVICE:-marble}"
TARGET_ANDROID="${TARGET_ANDROID:-15}"
TARGET_BUILD="${TARGET_BUILD:-OS3.0.5.0.VMRCNXM}"
TARGET_ROM_URL="${TARGET_ROM_URL:-https://bkt-sgp-miui-ota-update-alisgp.oss-ap-southeast-1.aliyuncs.com/OS3.0.5.0.VMRCNXM/marble-ota_full-OS3.0.5.0.VMRCNXM-user-15.0-727afd7728.zip}"

# --- Run mode -----------------------------------------------------------
# ANALYSIS_ONLY defaults to true. The source framework is Android 17
# against a target vendor baseline of Android 15 -- a real framework/
# vendor boundary (see docs/00-README.md). Analysis is cheap; a bad
# image rebuild is not. Flip to false only after reviewing
# build/reports/compatibility.md from an analysis run.
ANALYSIS_ONLY="${ANALYSIS_ONLY:-true}"

BUILD_KERNEL="${BUILD_KERNEL:-false}"
RUN_DEVICE_TEST="${RUN_DEVICE_TEST:-false}"
CREATE_RELEASE="${CREATE_RELEASE:-false}"

# Never silently disable verification. false = leave AVB as the target
# ROM ships it and only report state. true = an explicit, logged,
# opt-in choice for a test device.
DISABLE_AVB_FOR_TESTING="${DISABLE_AVB_FOR_TESTING:-false}"

# --- fstab / storage policy (carried over from the existing quick-port) -
# Stated preference: disable forceencrypt/fileencryption, mount
# system/vendor/product/odm rw, vendor+odm rebuilt as EXT4 (not EROFS).
DISABLE_FORCEENCRYPT="${DISABLE_FORCEENCRYPT:-true}"
MOUNT_RW_PARTITIONS="${MOUNT_RW_PARTITIONS:-system,vendor,product,odm}"
VENDOR_ODM_FS="${VENDOR_ODM_FS:-ext4}"

# --- Kernel integration ---------------------------------------------------
# Melt-Rebase kernel. NOTE: the source spec named the build repo
# "yudharn/Melt-Kernel-Marble", which does not match any repo confirmed
# reachable by inspection. Three separate, real, overridable repos are
# used below instead of one guessed name -- never blindly assumed, each
# checked directly against its actual latest release assets.

# Kernel *source* (for an optional from-scratch CI build -- see
# KERNEL_TRIGGER_REPO below). Confirmed reachable, branch melt-rebase.
KERNEL_SOURCE_REPO="${KERNEL_SOURCE_REPO:-yudharn/Build-kernel-Experimental}"
KERNEL_SOURCE_BRANCH="${KERNEL_SOURCE_BRANCH:-melt-rebase}"

# The actual kernel BOOT IMAGE (kernel+ramdisk, what marble boots).
# Stated instruction: use the pre-built boot.img published here. This
# is independent of BUILD_KERNEL below and defaults on -- it REPLACES
# the target ROM's passthrough boot.img in 08_kernel_integration.sh.
# Confirmed by inspection (bypassing the anonymous API rate limit via
# the release page's expanded_assets fragment, since api.github.com
# was exhausted): repo Yudharmdn/boot-melt-rebase, release tag
# "boot-melt-rebase", single real asset "boot.img" (192MB, sha256
# 29ea2b8f...c3fa3) alongside the two auto-generated source archives.
# KERNEL_BOOT_IMG_TAG empty = follow that repo's "latest" release
# instead of pinning this exact tag.
USE_CUSTOM_BOOT_IMG="${USE_CUSTOM_BOOT_IMG:-true}"
KERNEL_BOOT_IMG_REPO="${KERNEL_BOOT_IMG_REPO:-Yudharmdn/boot-melt-rebase}"
KERNEL_BOOT_IMG_TAG="${KERNEL_BOOT_IMG_TAG:-}"
KERNEL_BOOT_IMG_ASSET_NAME="${KERNEL_BOOT_IMG_ASSET_NAME:-boot.img}"

# Optional POST-BOOT root-solution companion zip -- NOT the kernel/boot
# image, unrelated to USE_CUSTOM_BOOT_IMG above. Corrected by the same
# inspection technique: this repo's latest release
# (5.10.270-Melt-Rebase-20260924_1059 at last check) actually ships SIX
# differently-named AnyKernel3-style zips -- three KernelSU forks
# (KernelSU-Next / Official-KernelSU / ReSukiSU), each in CORE and FULL
# variants, all bundled with SuSFS-NoMount -- not one generic kernel
# zip as originally assumed. Six meaningfully different root solutions
# is a real decision, not something to glob-match automatically: leave
# KERNEL_ROOT_VARIANT_ASSET_NAME empty to skip (WARN, lists what is
# available), or set it to the exact asset filename you want staged.
KERNEL_ARTIFACT_REPO="${KERNEL_ARTIFACT_REPO:-yudharn/POCOF5-Melt-Rebase-Kernel-Marble}"
KERNEL_ROOT_VARIANT_ASSET_NAME="${KERNEL_ROOT_VARIANT_ASSET_NAME:-}"

# Private CI repo is not addressable here (unknown name, private).
# BUILD_KERNEL=true (for the optional root-variant companion only)
# dispatches a workflow_dispatch event at it via API using
# KERNEL_TRIGGER_PAT -- NOT a reusable `workflow_call`, which is
# blocked public->private per prior findings. Set as a repo secret.
KERNEL_TRIGGER_REPO="${KERNEL_TRIGGER_REPO:-}"
KERNEL_TRIGGER_WORKFLOW_FILE="${KERNEL_TRIGGER_WORKFLOW_FILE:-build.yml}"

# --- Toolchain --------------------------------------------------------
WORKDIR="${WORKDIR:-${GITHUB_WORKSPACE:-$(pwd)}/build}"
SRC_DIR="$WORKDIR/source"
TGT_DIR="$WORKDIR/target"
WORK_TREE="$WORKDIR/workspace"
IMG_DIR="$WORKDIR/images"
REPORT_DIR="$WORKDIR/reports"
LOG_DIR="$WORKDIR/logs"

export SOURCE_DEVICE SOURCE_ANDROID SOURCE_BUILD SOURCE_ROM_URL \
       TARGET_DEVICE TARGET_ANDROID TARGET_BUILD TARGET_ROM_URL \
       ANALYSIS_ONLY BUILD_KERNEL RUN_DEVICE_TEST CREATE_RELEASE \
       DISABLE_AVB_FOR_TESTING DISABLE_FORCEENCRYPT MOUNT_RW_PARTITIONS \
       VENDOR_ODM_FS KERNEL_SOURCE_REPO KERNEL_SOURCE_BRANCH \
       USE_CUSTOM_BOOT_IMG KERNEL_BOOT_IMG_REPO KERNEL_BOOT_IMG_TAG \
       KERNEL_BOOT_IMG_ASSET_NAME KERNEL_ARTIFACT_REPO \
       KERNEL_ROOT_VARIANT_ASSET_NAME KERNEL_TRIGGER_REPO \
       KERNEL_TRIGGER_WORKFLOW_FILE \
       WORKDIR SRC_DIR TGT_DIR WORK_TREE IMG_DIR REPORT_DIR LOG_DIR
